{
  "name": "agent-to-figma",
  "description": "Let an AI agent read and edit Figma locally: MCP server + patched Figma plugin + Node relay (no Bun required).",
  "version": "0.2.1",
  "module": "dist/server.js",
  "main": "dist/server.js",
  "bin": {
    "agent-to-figma": "dist/server.js"
  },
  "files": [
    "dist",
    "node-relay",
    "src/cursor_mcp_plugin",
    "skills",
    "docs",
    "examples",
    "scripts",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "NOTICE.md"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepVite/agent-to-figma.git"
  },
  "homepage": "https://github.com/DeepVite/agent-to-figma#readme",
  "bugs": {
    "url": "https://github.com/DeepVite/agent-to-figma/issues"
  },
  "keywords": [
    "figma",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "figma-plugin",
    "websocket"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node dist/server.js",
    "relay": "node node-relay/socket.mjs",
    "send": "node node-relay/send-command.mjs",
    "test:relay": "node node-relay/test-relay.mjs",
    "setup:clients": "node scripts/setup-clients.mjs",
    "setup:skill": "node scripts/setup-clients.mjs --install-skill",
    "build": "tsup",
    "build:watch": "tsup --watch"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "bun-types": "1.4.5",
    "tsup": "^8.4.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.13.1",
    "uuid": "14.0.3",
    "ws": "8.23.0",
    "zod": "3.22.4"
  }
}
